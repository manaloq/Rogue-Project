# Unity-generated folders and files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/MemoryCaptures/
/Recordings/

# Ignore Addressables build cache
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Ignore Asset Bundles
/[Aa]ssets/StreamingAssets/*.bundle

# Ignore cache, temp, and generated files
.cache/
.temp/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.pidb
*.booproj
*.opendb
*.VC.db
*.idea/
*.iml

# Ignore Visual Studio and JetBrains Rider directories
.vs/
.gradle/
[Aa]ssets/Plugins/Editor/JetBrains*

# Ignore Unity Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Ignore Unity metadata and crash files
*.meta
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Builds and executables
*.apk
*.aab
*.unitypackage
*.exe
*.app
*.dmg
*.iso
*.ipa

# Debugging and profiling files
*.rsp
*.log
*.traceevents
*.info
*.map
*.state
*.prefs

# Crashlytics
crashlytics-build.properties

# Ignore custom tool-generated files
/[Aa]ssets/Plugins/Editor/CustomTool*

# Ignore third-party packages
/Packages/
/ProjectSettings/Packages/
/ProjectSettings/EditorBuildSettings.asset

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*

# Ignore local editor configuration
local.env
.env
.env.local
.env.*.local

# Ignore Unity Collaborate files
/[Cc]ollab/

# Ignore logs and analytics data
*.log
*.stats
*.analytics

# Ignore unnecessary hidden files
.DS_Store
Thumbs.db
Desktop.ini

# Other autogenerated files
*.bak
*.swp
*.tmp
*.backup
*.lock
*.old
*.orig

# Ignore scene preview cache
/[Ll]ibrary/SceneViewStates.asset

# Ignore unused asset importers
/[Ll]ibrary/ArtifactDB

# Ignore Unity-generated cache for shaders
/[Ll]ibrary/ShaderCache/

# Ignore Unity addressable assets build logs
/[Ll]ibrary/com.unity.addressables/
# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
